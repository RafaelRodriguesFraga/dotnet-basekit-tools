{
  "$schema": "http://json.schemastore.org/template",
  "author": "Rafael Fraga",
  "classifications": ["Web", "API", "Architecture", "DDD"],
  "name": "DotnetBaseKit Solution Template",
  "identity": "DotnetBaseKit.Templates.Solution",
  "shortName": "basekit",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "DotnetBaseKit",
  "preferNameDirectory": true,

  "symbols": {
    "componentsPrefix": {
      "type": "generated",
      "generator": "constant",
      "parameters": {
        "value": "DotnetBaseKit.Components"
      },
      "replaces": "BASEKIT_COMPONENTS_PACKAGE"
    },
    "database": {
      "type": "parameter",
      "datatype": "choice",
      "choices": [
        { "choice": "sql", "description": "MySQL" },
        { "choice": "mongodb", "description": "MongoDB" },
        { "choice": "postgresql", "description": "PostgreSQL" },
        { "choice": "sqlite", "description": "SQLite" },
        { "choice": "none", "description": "No database" }
      ],
      "defaultValue": "sql",
      "description": "Type of database"
    },
    "include-tests": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": "true",
      "description": "Include unit test project"
    }
  }
}