<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>DotnetBaseKit.Cli</RootNamespace>
    <AssemblyName>DotnetBaseKit.Cli</AssemblyName>
    <ToolCommandName>dotnet-basekit</ToolCommandName>
    <PackageId>DotnetBaseKit.Cli</PackageId>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <Title>DotnetBaseKit Interactive CLI</Title>
    <Authors>Rafael Fraga</Authors>
    <Description>
      Interactive CLI to initialize and manage projects with the DotnetBaseKit framework.
    </Description>
    <PackageTags>dotnet-tool;cli;architecture;ddd;dotnetbasekit</PackageTags>
    <PackAsTool>true</PackAsTool>

  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

</Project>
